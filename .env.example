BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
# IDs администраторов через запятую. Узнать свой ID: /id в новом боте.
ADMIN_IDS=
# Необязательно: свой служебный чат для загрузки аудио из инлайн-поиска.
# Указание ID разрешает новому боту отправлять туда выбранные в инлайн-режиме треки.
INLINE_CACHE_CHAT_ID=
# Необязательно: путь к постоянной SQLite-базе.
# DB_PATH=/data/bot.sqlite3
